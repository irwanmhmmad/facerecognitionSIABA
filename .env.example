APP_NAME=ABSEN Face Recognition Service
APP_ENV=development
DATABASE_URL=sqlite:///./face_service.db
POSTGRES_PASSWORD=replace-with-a-strong-database-password
INTERNAL_SERVICE_KEY=change-this-in-production
UPLOAD_TOKEN_SECRET=change-this-in-production-too
BIOMETRIC_ENCRYPTION_KEY=
TOKEN_ISSUER=absen-face-service
UPLOAD_TOKEN_TTL_SECONDS=600
ENROLLMENT_TTL_SECONDS=1800
VERIFICATION_TTL_SECONDS=300
ENROLLMENT_SAMPLE_COUNT=6
ENROLLMENT_CONSISTENCY_THRESHOLD=0.35
VERIFICATION_THRESHOLD=0.363
MAX_UPLOAD_BYTES=2000000
FACE_ENGINE=development
FACE_MODELS_ROOT=./models
OPENCV_DETECTOR_FILENAME=face_detection_yunet_2023mar.onnx
OPENCV_RECOGNIZER_FILENAME=face_recognition_sface_2021dec.onnx
OPENCV_DETECTOR_SHA256=8f2383e4dd3cfbb4553ea8718107fc0423210dc964f9f4280604804ed2552fa4
OPENCV_RECOGNIZER_SHA256=0ba9fbfa01b5270c96627c4ef784da859931e02f04419c829e83484087c34e79
OPENCV_DETECTION_SCORE_THRESHOLD=0.75
OPENCV_NMS_THRESHOLD=0.3
OPENCV_MIN_FACE_COVERAGE=0.08
OPENCV_MODEL_LICENSE_CONFIRMED=false
INSIGHTFACE_MODEL_NAME=licensed_model
FACE_MODEL_LICENSE_CONFIRMED=false
ONNX_PROVIDERS=CPUExecutionProvider
CORS_ORIGINS=
ABSENWEB_BASE_URL=http://127.0.0.1:8000
ABSENWEB_PROFILE_PATH=/api/get-my-profile
MOBILE_AUTH_TIMEOUT_SECONDS=8
